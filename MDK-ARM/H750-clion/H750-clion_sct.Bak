; *************************************************************
; *** Scatter-Loading Description File generated by uVision ***
; *************************************************************

LR_ROM1 0x90000000 0x00800000  {    ; 定义一个加载区域 LR_ROM1, 起始地址为 0x90000000，大小为 0x00800000 (8MB)
  ER_ROM1 0x90000000 0x00800000  {  ; 定义一个执行区域 ER_ROM1，起始地址与加载区域相同，大小也为 8MB
   *.o (RESET, +First)               ; 包含所有对象文件(.o)中标记为RESET的部分，这部分内容放置在执行区的最开始(+First 表示优先级最高)
   *(InRoot$$Sections)               ; 包括所有标记为 InRoot$$Sections 的段
   .ANY (+RO)                        ; 将任何只读数据(.RO)放入此执行区域
   .ANY (+XO)                        ; 将任何可执行数据(.XO)放入此执行区域
  }
  RW_IRAM1 0x20000000 0x00020000  {  ; 定义一个读写数据区 RW_IRAM1，起始地址为 0x20000000，大小为 0x00020000 (128KB)
   .ANY (+RW +ZI)                    ; 将任何读写数据(.RW)和零初始化数据(.ZI)放入此区域
  }
    RW_IRAM2 0x24000000 0x00080000  {  ; 定义一个读写数据区 RW_IRAM2，起始地址是 0x24000000，大小是 0x00080000 (512KB)
   .ANY (.AXI_SRAM)                  ; 将所有标记为 .lvgl.dma 的段放入这个区域，专门用于LVGL库的DMA传输缓冲区
   」}
}



