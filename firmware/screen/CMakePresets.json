{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {}
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "DebugNew",
            "inherits": "Debug",
            "cacheVariables": {
                "HTP_LCD_PANEL": "NEW"
            }
        },
        {
            "name": "DebugOld",
            "inherits": "Debug",
            "cacheVariables": {
                "HTP_LCD_PANEL": "OLD"
            }
        },
        {
            "name": "ReleaseNew",
            "inherits": "Release",
            "cacheVariables": {
                "HTP_LCD_PANEL": "NEW"
            }
        },
        {
            "name": "ReleaseOld",
            "inherits": "Release",
            "cacheVariables": {
                "HTP_LCD_PANEL": "OLD"
            }
        },
        {
            "name": "DebugNov11",
            "inherits": "Debug",
            "cacheVariables": {
                "HTP_LCD_PANEL": "NOV11"
            }
        },
        {
            "name": "ReleaseNov11",
            "inherits": "Release",
            "cacheVariables": {
                "HTP_LCD_PANEL": "NOV11"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "DebugNew",
            "configurePreset": "DebugNew"
        },
        {
            "name": "DebugOld",
            "configurePreset": "DebugOld"
        },
        {
            "name": "ReleaseNew",
            "configurePreset": "ReleaseNew"
        },
        {
            "name": "ReleaseOld",
            "configurePreset": "ReleaseOld"
        }
    ]
}
